{
  "name": "di-framework-kube-examples",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "deploy": "bun scripts/deploy.ts",
    "smoke": "bun scripts/smoke.ts",
    "smoke:tls": "bun scripts/tls-smoke.ts",
    "link:framework": "bun scripts/link-framework.ts",
    "runtime:tls": "bun scripts/tls-runtime.ts",
    "verify:tls": "bun run deploy node-tls && bun run smoke node-tls"
  },
  "dependencies": {
    "@di-framework/core": "link:@di-framework/core",
    "@di-framework/http": "link:@di-framework/http"
  },
  "devDependencies": {
    "@di-framework/cli": "link:@di-framework/cli",
    "@di-framework/cli-extension": "link:@di-framework/cli-extension",
    "@di-framework/cli-plugin-wasmcloud": "link:@di-framework/cli-plugin-wasmcloud",
    "@types/bun": "1.3.14",
    "rolldown": "1.2.7",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@di-framework/core": "link:@di-framework/core",
    "@di-framework/http": "link:@di-framework/http",
    "@di-framework/cli": "link:@di-framework/cli",
    "@di-framework/cli-extension": "link:@di-framework/cli-extension",
    "@di-framework/cli-plugin-wasmcloud": "link:@di-framework/cli-plugin-wasmcloud"
  }
}
